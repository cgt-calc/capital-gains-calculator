    {%- endif %}
]
{% elif event.kind == "management_fee" %}
=== Cost added to {{ event.symbol }} with no new shares: £{{ event.cost|money }}
{% elif event.kind == "spin_off" %}
    {% if event.quantity > 0 %}
=== Spin-off adjustment {{ event.number }}: {{ event.spin_off_source }} cost adjusted because of {{ event.spin_off_dest }} shares spun off
    {% endif %}
{% elif event.kind == "eri" %}
    {% if event.quantity > 0 %}
=== Excess Reported Income: {{ event.symbol }} cost increased by £{{ event.cost|money }} (£{{ event.eri_unit_price|money }}/unit)
    {% endif %}
{% elif event.kind == "rename" %}
#heading(level: 3)[
    {{ event.symbol }} was renamed to {{ event.renamed_to }}
    {%- if event.quantity > 0 -%}
