#heading(level: 3)[
    Disposal {{ event.number }}: grant of {{ strip_zeros(event.quantity) }}
    contract{% if event.quantity != 1 %}s{% endif %} of the {{ event.symbol }}
    for £{{ event.proceeds|money }}
]
    {% else %}
#heading(level: 3)[
    Disposal {{ event.number }}: {{ strip_zeros(event.quantity) }} units of {{ event.symbol }}
    {% if event.is_gift %}given away at a market value of{% else %}for{% endif %} £{{ event.proceeds|money }}
    (£{{ event.per_unit|money }}/unit)
    {%- if event.fees > 0 -%}
    , £{{ event.fees|money }} fees allowed as cost
    {%- endif %}
]
    {% endif %}
    {% if event.outcome == "gain" %}
